#!/usr/bin/env python3
"""Pre-push hook: run CI's content-integrity steps on each pushed commit.

Lesson E158 (articles/inner-child-therapy/experiments/
DANGEROUS-ADULT-SELF-AUDIT-RULES-20260924.md): with a merge request open,
every push is a head Joel can merge, and CI checks each one, so every push
has to pass what CI checks, not only the last push of a turn.

Install once per clone, from the repository root:

    ln -sf ../../tools/humanization/git-hooks/pre-push .git/hooks/pre-push

For each pushed commit it makes a temporary worktree and runs there the
single-line `run:` steps of .github/workflows/content-integrity.yml, so it
follows the workflow when the workflow changes. Any failing step refuses
the push.

Before that, the route (gate E339; Joel, 2026-11-04 00:37 UTC: "make sure
no other lane can make the same mistake you made next time"): a lane pushes
only through tools/humanization/lane_push.py, which checks that main is
merged, that the branch has a pull request and that no other open pull
request changes the same shared files, and sets LANE_PUSH=1. A plain
`git push` is refused. A push that isn't a lane's (a maintainer fixing a
branch by hand) sets LANE_PUSH_BYPASS to its reason. lane_push.py and
lane_mailbox.py install this hook when a clone doesn't have it.
"""
import os
import re
import shutil
import subprocess
import sys
import tempfile

WORKFLOW = '.github/workflows/content-integrity.yml'
ZERO = '0' * 40


def steps(path):
    """The workflow's single-line `run:` commands, in order."""
    cmds = []
    with open(path, encoding='utf-8') as f:
        for line in f:
            m = re.match(r'\s*(?:-\s+)?run:\s*(.+?)\s*$', line)
            if not m:
                continue
            cmd = m.group(1)
            if cmd[0] in '|>':
                print(f'pre-push: a multi-line step in {WORKFLOW} is not run here',
                      file=sys.stderr)
                continue
            # CI's runner calls it `python`; use the interpreter running this hook.
            cmds.append(re.sub(r'^python\b', sys.executable, cmd))
    return cmds


def check(root, ref, sha):
    """Run the steps on one commit; True if they all pass."""
    tmp = tempfile.mkdtemp(prefix='pre-push-')
    wt = os.path.join(tmp, 'wt')
    try:
        subprocess.run(['git', '-C', root, 'worktree', 'add', '-q', '--detach', wt, sha],
                       check=True)
        workflow = os.path.join(wt, WORKFLOW)
        if not os.path.exists(workflow):
            return True
        # the steps run without git's GIT_* variables: inside a hook GIT_DIR names the repository being pushed, so a step's
        # git command would act on it instead of the temporary worktree (2026-11-04: a test's `git init` in a temporary
        # folder re-initialized the shared repository and set core.bare = true)
        env = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
        for cmd in steps(workflow):
            r = subprocess.run(cmd, shell=True, cwd=wt, capture_output=True, text=True, env=env)
            if r.returncode:
                print(f'pre-push: {ref} ({sha[:8]}) fails: {cmd}', file=sys.stderr)
                print((r.stdout + r.stderr)[-4000:], file=sys.stderr)
                return False
        return True
    finally:
        subprocess.run(['git', '-C', root, 'worktree', 'remove', '--force', wt],
                       capture_output=True)
        shutil.rmtree(tmp, ignore_errors=True)


def route_refusal(env):
    """'' when the push came through lane_push.py (or says why it didn't need to), else why it is refused."""
    if env.get('LANE_PUSH') == '1' or env.get('LANE_PUSH_BYPASS', '').strip():
        return ''
    return ('pre-push: refused. A lane pushes with tools/humanization/lane_push.py, which refuses a push when\n'
            'origin/main is not merged, when the branch has no pull request, or when another open\n'
            'pull request changes the same shared files (gate E339):\n'
            '  python3 tools/humanization/lane_push.py "subject" --mailbox "<turn>" --article <slug> [--pr ...]\n'
            'A push that is not a lane\'s sets LANE_PUSH_BYPASS="the reason".')


def main():
    why = route_refusal(os.environ)
    if why:
        print(why, file=sys.stderr)
        return 1
    root = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True,
                          text=True, check=True).stdout.strip()
    ok = True
    for line in sys.stdin:
        parts = line.split()
        if len(parts) != 4 or parts[1] == ZERO:
            continue  # a deleted ref has nothing to check
        ok = check(root, parts[0], parts[1]) and ok
    if not ok:
        print('pre-push: refused. If the content validator failed, run\n'
              '  python3 scripts/register_article_artifacts.py --article <slug> --write\n'
              'after the last edit, commit, and push again.', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
