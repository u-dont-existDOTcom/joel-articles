#!/usr/bin/env python3
"""Pre-push hook: run CI's content-integrity steps on each pushed commit.

Lesson E158 (articles/inner-child-therapy/experiments/
DANGEROUS-ADULT-SELF-AUDIT-RULES-20260924.md): with a merge request open,
every push is a head Joel can merge, and CI checks each one, so every push
has to pass what CI checks, not only the last push of a turn.

Install once per clone, from the repository root:

    ln -sf ../../tools/humanization/git-hooks/pre-push .git/hooks/pre-push

For each pushed commit it makes a temporary worktree and runs there the
single-line `run:` steps of .github/workflows/content-integrity.yml, so it
follows the workflow when the workflow changes. Any failing step refuses
the push.
"""
import os
import re
import shutil
import subprocess
import sys
import tempfile

WORKFLOW = '.github/workflows/content-integrity.yml'
ZERO = '0' * 40


def steps(path):
    """The workflow's single-line `run:` commands, in order."""
    cmds = []
    with open(path, encoding='utf-8') as f:
        for line in f:
            m = re.match(r'\s*(?:-\s+)?run:\s*(.+?)\s*$', line)
            if not m:
                continue
            cmd = m.group(1)
            if cmd[0] in '|>':
                print(f'pre-push: a multi-line step in {WORKFLOW} is not run here',
                      file=sys.stderr)
                continue
            # CI's runner calls it `python`; use the interpreter running this hook.
            cmds.append(re.sub(r'^python\b', sys.executable, cmd))
    return cmds


def check(root, ref, sha):
    """Run the steps on one commit; True if they all pass."""
    tmp = tempfile.mkdtemp(prefix='pre-push-')
    wt = os.path.join(tmp, 'wt')
    try:
        subprocess.run(['git', '-C', root, 'worktree', 'add', '-q', '--detach', wt, sha],
                       check=True)
        workflow = os.path.join(wt, WORKFLOW)
        if not os.path.exists(workflow):
            return True
        for cmd in steps(workflow):
            r = subprocess.run(cmd, shell=True, cwd=wt, capture_output=True, text=True)
            if r.returncode:
                print(f'pre-push: {ref} ({sha[:8]}) fails: {cmd}', file=sys.stderr)
                print((r.stdout + r.stderr)[-4000:], file=sys.stderr)
                return False
        return True
    finally:
        subprocess.run(['git', '-C', root, 'worktree', 'remove', '--force', wt],
                       capture_output=True)
        shutil.rmtree(tmp, ignore_errors=True)


def main():
    root = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True,
                          text=True, check=True).stdout.strip()
    ok = True
    for line in sys.stdin:
        parts = line.split()
        if len(parts) != 4 or parts[1] == ZERO:
            continue  # a deleted ref has nothing to check
        ok = check(root, parts[0], parts[1]) and ok
    if not ok:
        print('pre-push: refused. If the content validator failed, run\n'
              '  python3 scripts/register_article_artifacts.py --article <slug> --write\n'
              'after the last edit, commit, and push again.', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
